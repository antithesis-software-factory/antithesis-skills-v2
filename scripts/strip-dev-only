#!/usr/bin/env python3
"""Remove development-only content from the plugin before a release.

Development-only content is either a whole file whose first line contains
`DEV-ONLY`, or a block between `<!-- dev-only:start -->` and
`<!-- dev-only:end -->` lines.

    scripts/strip-dev-only          delete it in place
    scripts/strip-dev-only --check  list it and exit 1 if any is left
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent / "plugins"
BLOCK = re.compile(r"^[ \t]*<!-- dev-only:start -->\n.*?^[ \t]*<!-- dev-only:end -->\n", re.S | re.M)


def main() -> int:
    check = "--check" in sys.argv[1:]
    found = []
    for path in sorted(ROOT.rglob("*.md")):
        text = path.read_text()
        if "DEV-ONLY" in text.split("\n", 1)[0]:
            found.append(f"{path.relative_to(ROOT.parent)}: whole file")
            if not check:
                path.unlink()
            continue
        blocks = BLOCK.findall(text)
        if blocks:
            found.append(f"{path.relative_to(ROOT.parent)}: {len(blocks)} block(s)")
            if not check:
                path.write_text(BLOCK.sub("", text))
    for line in found:
        print(line)
    if check:
        return 1 if found else 0
    print(f"removed {len(found)} item(s)" if found else "nothing to remove")
    return 0


if __name__ == "__main__":
    sys.exit(main())
